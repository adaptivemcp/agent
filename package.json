{
  "name": "@adaptivemcp/agent",
  "version": "0.1.0",
  "description": "The Adaptive MCP agent: an MCP-native agent host that closes the adaptation loop by owning both the LLM completion and the MCP execution.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "adaptivemcp-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "QC_MCP_INTEGRATION=1 vitest run src/mcp/qc-mcp.integration.test.ts",
    "test:system1": "SYSTEM1_LIVE=1 vitest run src/decision/systemone.live.test.ts",
    "dev": "tsx src/cli.ts",
    "demo": "tsx examples/vertical-slice.ts"
  },
  "dependencies": {
    "@adaptivemcp/approval": "^0.2.4",
    "@adaptivemcp/evaluation": "^0.4.0",
    "@adaptivemcp/graph-analysis": "^0.2.1",
    "@adaptivemcp/memory": "^0.4.0",
    "@adaptivemcp/middleware": "^0.1.2",
    "@adaptivemcp/orchestration": "^0.2.4",
    "@adaptivemcp/routing": "^0.4.0",
    "@adaptivemcp/runtime": "^0.4.0",
    "@adaptivemcp/spec": "^0.4.0",
    "@adaptivemcp/thin-client": "^0.4.0",
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/openai": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.0",
    "js-yaml": "^5.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.0"
  }
}
